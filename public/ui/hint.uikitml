<!-- Tutorial / hint card, placed in the world in front of the player. -->
<style>
  .root {
    flex-direction: column;
    width: 70;
    padding-top: 3;
    padding-bottom: 3;
    padding-left: 3.5;
    padding-right: 3.5;
    gap: 1.6;
    background-color: #0f171e;
    border-radius: 2.5;
    border-width: 0.35;
    border-color: #9ff7ef;
  }
  .head {
    font-size: 2.8;
    font-weight: 700;
    color: #9ff7ef;
  }
  .text {
    font-size: 3.2;
    line-height: 1.35;
    color: #f4f1e8;
  }
  .btn {
    padding-top: 1.3;
    padding-bottom: 1.3;
    border-radius: 1.4;
    background-color: #1e2c37;
    border-width: 0.25;
    border-color: #2f4757;
    font-size: 2.8;
    color: #f4f1e8;
    text-align: center;
    cursor: pointer;
  }
  .btn:hover {
    background-color: #3fa7a3;
    color: #0b1014;
  }
</style>
<div class="root">
  <div class="head">Tip</div>
  <div id="hint_text" class="text">Hint text</div>
  <div id="hint_ok" class="btn">Got it</div>
</div>
