  "pickups": [
    { "item": "lens", "at": "part_lens" },
    { "item": "spring", "at": "part_spring" },
    { "item": "valve", "at": "part_valve" }
  ],
  "triggers": [
    { "id": "t_reached_gate", "kind": "area", "at": "gate", "radius": 6, "when": { "flag": "warden_intro_done" }, "effects": [{ "setFlag": "reached_gate" }] },
    { "id": "t_hint_grab_lens", "kind": "pickup", "item": "lens", "when": { "not": { "flag": "hint_deliver_shown" } }, "effects": [{ "setFlag": "hint_deliver_shown" }, { "hint": "hint_deliver" }] },
    { "id": "t_hint_grab_spring", "kind": "pickup", "item": "spring", "when": { "not": { "flag": "hint_deliver_shown" } }, "effects": [{ "setFlag": "hint_deliver_shown" }, { "hint": "hint_deliver" }] },
    { "id": "t_hint_grab_valve", "kind": "pickup", "item": "valve", "when": { "not": { "flag": "hint_deliver_shown" } }, "effects": [{ "setFlag": "hint_deliver_shown" }, { "hint": "hint_deliver" }] },
    { "id": "t_deliver_lens", "kind": "deliver", "item": "lens", "at": "workshop_bin", "radius": 1.3, "when": { "flag": "met_tobbin" }, "effects": [{ "takeItem": "lens" }, { "setFlag": "delivered_lens" }, { "emit": "part_delivered" }] },
    { "id": "t_deliver_spring", "kind": "deliver", "item": "spring", "at": "workshop_bin", "radius": 1.3, "when": { "flag": "met_tobbin" }, "effects": [{ "takeItem": "spring" }, { "setFlag": "delivered_spring" }, { "emit": "part_delivered" }] },
    { "id": "t_deliver_valve", "kind": "deliver", "item": "valve", "at": "workshop_bin", "radius": 1.3, "when": { "flag": "met_tobbin" }, "effects": [{ "takeItem": "valve" }, { "setFlag": "delivered_valve" }, { "emit": "part_delivered" }] },
    { "id": "t_shrine_pulse", "kind": "pulse", "at": "shrine_console", "radius": 3, "when": { "item": "pulse_lantern" }, "effects": [{ "setFlag": "shrine_awakened" }, { "emit": "shrine_awaken" }] }
  ],
  "events": ["part_delivered", "shrine_awaken", "lantern_given"]
}
